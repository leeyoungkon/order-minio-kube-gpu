RUN_MODE=demo
STATE_DB=./inventory_agent.db
OLLAMA_URL=http://127.0.0.1:15000
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
EVALUATION_COOLDOWN_SECONDS=30
